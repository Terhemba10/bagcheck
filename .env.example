# Copy to .env.local and fill in. Never commit real values.

# CoinMarketCap Pro API key (pro.coinmarketcap.com -> Account -> API Key)
CMC_API_KEY=

# Optional: simulate the free Basic plan (Startup-only endpoints return 1006). Values: basic | (empty)
CMC_FORCE_PLAN=

# Upstash Redis (console.upstash.com -> database -> REST API). Without these, an in-memory store is used (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Telegram bot (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for POST /api/cron/check (any long random string)
CRON_SECRET=
